# c2pa-stripcheck — example environment file.
#
# Copy to .env (which is git-ignored) and fill in real values to run LIVE
# platform probes. The --demo path needs NONE of these.
#
# Never commit real tokens. All adapters read credentials from the environment;
# nothing is hardcoded.

# Instagram (Graph API — Business/Creator account)
IG_TOKEN=your-instagram-graph-api-token

# X / Twitter (API v2)
X_BEARER_TOKEN=your-x-bearer-token

# WhatsApp Cloud API
WHATSAPP_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_ID=your-whatsapp-phone-number-id

# Reddit (script app)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_REFRESH_TOKEN=your-reddit-refresh-token

# TikTok (Content Posting API)
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token

# LinkedIn (UGC / Assets API)
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token

# Optional: CAI Soft-Binding Resolution API base URL (defaults to the public CAI
# endpoint). Used to look up provenance when only a soft binding survives.
# CAI_SOFT_BINDING_API=https://cai-soft-binding.example/api
